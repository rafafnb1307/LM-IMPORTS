{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/login",    "destination": "/auth/login.html" },
    { "source": "/register", "destination": "/auth/register.html" },
    { "source": "/conta",    "destination": "/auth/conta.html" }
  ]
}
